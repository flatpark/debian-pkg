diff --git a/doc/flatpak-clean.xml b/doc/flatpak-clean.xml
new file mode 100644
index 00000000..375788aa
--- /dev/null
+++ b/doc/flatpak-clean.xml
@@ -0,0 +1,96 @@
+<?xml version='1.0'?> <!--*-nxml-*-->
+<!DOCTYPE refentry PUBLIC "-//OASIS//DTD DocBook XML V4.5//EN"
+    "http://www.oasis-open.org/docbook/xml/4.5/docbookx.dtd">
+
+<refentry id="flatpak-clean">
+    <refentryinfo>
+        <title>flatpak clean</title>
+        <productname>flatpak</productname>
+    </refentryinfo>
+
+    <refmeta>
+        <refentrytitle>flatpak clean</refentrytitle>
+        <manvolnum>1</manvolnum>
+    </refmeta>
+
+    <refnamediv>
+        <refname>flatpak-clean</refname>
+        <refpurpose>Remove cached extra-data from the local repository</refpurpose>
+    </refnamediv>
+
+    <refsynopsisdiv>
+        <cmdsynopsis>
+            <command>flatpak clean</command>
+            <arg choice="opt" rep="repeat">OPTION</arg>
+        </cmdsynopsis>
+    </refsynopsisdiv>
+
+    <refsect1>
+        <title>Description</title>
+        <para>
+            Removes embedded extra-data from commits in a local Flatpak repository.
+            It also removes incomplete <filename>.part</filename> downloads from the
+            per-user extra-data directory. Other files in that directory are reported
+            and left unchanged.
+        </para>
+        <para>
+            The repository is locked exclusively while it is inspected and modified.
+            Cleaning a system installation requires direct write access to its repository
+            and does not use the Flatpak system helper.
+        </para>
+    </refsect1>
+
+    <refsect1>
+        <title>Options</title>
+        <variablelist>
+            <varlistentry>
+                <term><option>-h</option></term>
+                <term><option>--help</option></term>
+                <listitem><para>Show help options and exit.</para></listitem>
+            </varlistentry>
+            <varlistentry>
+                <term><option>-u</option></term>
+                <term><option>--user</option></term>
+                <listitem><para>Clean the per-user installation.</para></listitem>
+            </varlistentry>
+            <varlistentry>
+                <term><option>--system</option></term>
+                <listitem><para>Clean the default system-wide installation.</para></listitem>
+            </varlistentry>
+            <varlistentry>
+                <term><option>--installation=NAME</option></term>
+                <listitem><para>
+                    Clean the system-wide installation specified by
+                    <arg choice="plain">NAME</arg>.
+                </para></listitem>
+            </varlistentry>
+            <varlistentry>
+                <term><option>--dry-run</option></term>
+                <listitem><para>Report what would be removed without making changes.</para></listitem>
+            </varlistentry>
+            <varlistentry>
+                <term><option>-v</option></term>
+                <term><option>--verbose</option></term>
+                <listitem><para>Print debug information during command processing.</para></listitem>
+            </varlistentry>
+            <varlistentry>
+                <term><option>--ostree-verbose</option></term>
+                <listitem><para>Print OSTree debug information during command processing.</para></listitem>
+            </varlistentry>
+        </variablelist>
+    </refsect1>
+
+    <refsect1>
+        <title>Examples</title>
+        <para><command>$ flatpak clean --user --dry-run</command></para>
+        <para><command>$ sudo flatpak clean --system</command></para>
+    </refsect1>
+
+    <refsect1>
+        <title>See also</title>
+        <para>
+            <citerefentry><refentrytitle>flatpak</refentrytitle><manvolnum>1</manvolnum></citerefentry>,
+            <citerefentry><refentrytitle>flatpak-repair</refentrytitle><manvolnum>1</manvolnum></citerefentry>
+        </para>
+    </refsect1>
+</refentry>
