From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Komh <mail@guojing.io>
Date: Sat, 24 Oct 2026 18:04:19 +0800
Subject: [PATCH] extra-data: mark prefetched files so leftovers are reclaimed

---
 app/flatpak-builtins-clean.c         |  30 ++++++++
 common/flatpak-extra-data-prefetch.c | 107 ++++++++++++++++++++++++---
 tests/test-extra-data.sh             |  40 +++++++++-
 3 files changed, 162 insertions(+), 15 deletions(-)

diff --git a/app/flatpak-builtins-clean.c b/app/flatpak-builtins-clean.c
index 509d6424..6ceb952f 100644
--- a/app/flatpak-builtins-clean.c
+++ b/app/flatpak-builtins-clean.c
@@ -13,6 +13,8 @@
 #include "flatpak-extra-data-private.h"
 #include "flatpak-utils-private.h"
 
+#define PREFETCH_MARKER ".flatpak-prefetch"
+
 static gboolean opt_dry_run;
 
 static GOptionEntry options[] = {
@@ -118,8 +120,36 @@ clean_extra_data_dir (GFile        *dir,
                       GError      **error)
 {
   g_autoptr(GFileEnumerator) enumerator = NULL;
+  g_autoptr(GFile) marker = g_file_get_child (dir, PREFETCH_MARKER);
+  g_autoptr(GFileInfo) marker_info = NULL;
   g_autoptr(GError) local_error = NULL;
 
+  marker_info = g_file_query_info (marker, G_FILE_ATTRIBUTE_STANDARD_TYPE,
+                                   G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS,
+                                   cancellable, &local_error);
+  if (marker_info != NULL && g_file_info_get_file_type (marker_info) == G_FILE_TYPE_REGULAR)
+    {
+      g_autofree char *path = g_file_get_path (dir);
+      guint64 size;
+
+      if (!g_file_measure_disk_usage (dir, G_FILE_MEASURE_NONE, cancellable, NULL, NULL,
+                                      &size, NULL, NULL, error))
+        return FALSE;
+
+      g_print ("%.1f MB  %s\n", size / (1024.0 * 1024.0), path);
+      if (!opt_dry_run && !flatpak_rm_rf (dir, cancellable, error))
+        return FALSE;
+      (*objects)++;
+      *freed_bytes += size;
+      return TRUE;
+    }
+  if (marker_info == NULL && !g_error_matches (local_error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND))
+    {
+      g_propagate_error (error, g_steal_pointer (&local_error));
+      return FALSE;
+    }
+  g_clear_error (&local_error);
+
   enumerator = g_file_enumerate_children (dir,
                                           G_FILE_ATTRIBUTE_STANDARD_NAME ","
                                           G_FILE_ATTRIBUTE_STANDARD_TYPE ","
diff --git a/common/flatpak-extra-data-prefetch.c b/common/flatpak-extra-data-prefetch.c
index 550c4298..60200680 100644
--- a/common/flatpak-extra-data-prefetch.c
+++ b/common/flatpak-extra-data-prefetch.c
@@ -17,6 +17,7 @@
 #define DEFAULT_PARALLEL_DOWNLOADS 4
 #define MAX_DOWNLOADS_PER_HOST 4
 #define MAX_DOWNLOAD_ATTEMPTS 3
+#define PREFETCH_MARKER ".flatpak-prefetch"
 
 typedef struct
 {
@@ -71,6 +72,35 @@ get_job_path (PrefetchJob *job,
   return g_file_get_path (file);
 }
 
+static void
+remove_job_directory_if_empty (const char *dir)
+{
+  g_autoptr(GDir) d = NULL;
+  g_autofree char *marker = g_build_filename (dir, PREFETCH_MARKER, NULL);
+  const char *name;
+  gboolean have_marker = FALSE;
+
+  d = g_dir_open (dir, 0, NULL);
+  if (d == NULL)
+    return;
+
+  while ((name = g_dir_read_name (d)) != NULL)
+    {
+      if (strcmp (name, PREFETCH_MARKER) == 0)
+        have_marker = TRUE;
+      else
+        return;
+    }
+
+  if (have_marker && g_unlink (marker) != 0 && errno != ENOENT)
+    {
+      g_debug ("Unable to remove extra-data prefetch marker %s: %s", marker, g_strerror (errno));
+      return;
+    }
+  if (g_rmdir (dir) != 0 && errno != ENOENT && errno != ENOTEMPTY)
+    g_debug ("Unable to remove extra-data prefetch directory %s: %s", dir, g_strerror (errno));
+}
+
 static void
 remove_job_file (PrefetchJob *job,
                  gboolean     partial)
@@ -80,8 +110,35 @@ remove_job_file (PrefetchJob *job,
 
   if (g_unlink (path) != 0 && errno != ENOENT)
     g_debug ("Unable to remove extra-data prefetch file %s: %s", path, g_strerror (errno));
-  if (g_rmdir (dir) != 0 && errno != ENOENT && errno != ENOTEMPTY)
-    g_debug ("Unable to remove extra-data prefetch directory %s: %s", dir, g_strerror (errno));
+  remove_job_directory_if_empty (dir);
+}
+
+static gboolean
+ensure_job_directory (const char  *dir,
+                      gboolean    *out_marked,
+                      GError     **error)
+{
+  g_autofree char *parent = g_path_get_dirname (dir);
+  g_autofree char *marker = g_build_filename (dir, PREFETCH_MARKER, NULL);
+
+  if (g_mkdir_with_parents (parent, 0755) != 0)
+    return glnx_throw_errno_prefix (error, "Unable to create extra-data directory %s", parent);
+
+  if (g_mkdir (dir, 0755) == 0)
+    {
+      if (!g_file_set_contents (marker, "", 0, error))
+        {
+          g_rmdir (dir);
+          return FALSE;
+        }
+      *out_marked = TRUE;
+    }
+  else if (errno == EEXIST)
+    *out_marked = g_file_test (marker, G_FILE_TEST_IS_REGULAR);
+  else
+    return glnx_throw_errno_prefix (error, "Unable to create extra-data prefetch directory %s", dir);
+
+  return TRUE;
 }
 
 static void
@@ -177,11 +234,44 @@ prefetch_worker (gpointer data,
   g_autofree char *part_path = get_job_path (job, TRUE);
   g_autofree char *parent = g_path_get_dirname (path);
   gboolean success = FALSE;
-  gboolean have_host_slot;
+  gboolean marked = FALSE;
+  gboolean have_host_slot = FALSE;
+  g_autoptr(GError) setup_error = NULL;
 
-  have_host_slot = acquire_host_slot (job);
-  if (have_host_slot && g_file_test (path, G_FILE_TEST_EXISTS))
-    success = TRUE;
+  if (!ensure_job_directory (parent, &marked, &setup_error))
+    g_debug ("Unable to prepare extra-data prefetch for %s: %s", job->uri, setup_error->message);
+  else
+    {
+      if (marked)
+        {
+          g_autoptr(GError) validation_error = NULL;
+
+          if (g_unlink (part_path) != 0 && errno != ENOENT)
+            g_debug ("Unable to remove partial extra-data prefetch file %s: %s",
+                     part_path, g_strerror (errno));
+          if (g_file_test (path, G_FILE_TEST_EXISTS))
+            {
+              if (validate_download (path, job, &validation_error))
+                {
+                  job->created = TRUE;
+                  success = TRUE;
+                }
+              else
+                {
+                  g_debug ("Discarding invalid extra-data prefetch file %s: %s",
+                           path, validation_error->message);
+                  if (g_unlink (path) != 0 && errno != ENOENT)
+                    g_debug ("Unable to remove invalid extra-data prefetch file %s: %s",
+                             path, g_strerror (errno));
+                }
+            }
+        }
+      else if (g_file_test (path, G_FILE_TEST_EXISTS))
+        success = TRUE;
+
+      if (!success)
+        have_host_slot = acquire_host_slot (job);
+    }
 
   for (guint attempt = 0; have_host_slot && !success && attempt < MAX_DOWNLOAD_ATTEMPTS; attempt++)
     {
@@ -192,11 +282,6 @@ prefetch_worker (gpointer data,
 
       if (g_cancellable_is_cancelled (self->cancellable))
         break;
-      if (g_mkdir_with_parents (parent, 0755) != 0)
-        {
-          g_debug ("Unable to create extra-data prefetch directory %s: %s", parent, g_strerror (errno));
-          break;
-        }
 
       out = g_file_replace (part_file, NULL, FALSE, G_FILE_CREATE_PRIVATE,
                             self->cancellable, &local_error);
diff --git a/tests/test-extra-data.sh b/tests/test-extra-data.sh
index 94a890a6..0642aa37 100755
--- a/tests/test-extra-data.sh
+++ b/tests/test-extra-data.sh
@@ -48,7 +48,8 @@ EXTRA_DATA_SIZE=$(stat --printf="%s" "${DOWNLOADED_EXTRA_DATA}")
 EXTRA_DATA_SHA256=$(sha256sum "${DOWNLOADED_EXTRA_DATA}" | cut -f1 -d' ')
 
 # build the app with the extra data
-EXTRA_DATA="--extra-data=test:${EXTRA_DATA_SHA256}:${EXTRA_DATA_SIZE}:${EXTRA_DATA_SIZE}:${EXTRA_DATA_URL}"
+EXTRA_DATA_NAME="test"
+EXTRA_DATA="--extra-data=${EXTRA_DATA_NAME}:${EXTRA_DATA_SHA256}:${EXTRA_DATA_SIZE}:${EXTRA_DATA_SIZE}:${EXTRA_DATA_URL}"
 BUILD_FINISH_ARGS=${EXTRA_DATA} make_updated_app ${REPONAME} ${COLLECTION_ID} ${BRANCH} UPDATE1
 
 # ensure it installs correctly
@@ -57,7 +58,7 @@ install_repo ${REPONAME} ${BRANCH}
 # ensure the right extra-data got downloaded
 ${FLATPAK} run --command=sh org.test.Hello -c "cat /app/extra/test" > out
 assert_file_has_content out "extra-data-test-content"
-assert_not_has_file "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/${EXTRA_DATA_FILE}"
+assert_not_has_file "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/${EXTRA_DATA_NAME}"
 
 EXTRA_DATA_COMMIT=$(${FLATPAK} ${U} info --show-commit org.test.Hello)
 ostree --repo="${FL_DIR}/repo" show --list-detached-metadata-keys "${EXTRA_DATA_COMMIT}" > detached-keys
@@ -78,11 +79,16 @@ ok "keep extra data in detached metadata when configured"
 mkdir -p "${USERDIR}/extra-data/cleanup"
 printf partial > "${USERDIR}/extra-data/cleanup/orphan.part"
 printf keep > "${USERDIR}/extra-data/cleanup/keep.txt"
+mkdir -p "${USERDIR}/extra-data/prefetch-cleanup"
+touch "${USERDIR}/extra-data/prefetch-cleanup/.flatpak-prefetch"
+printf prefetched > "${USERDIR}/extra-data/prefetch-cleanup/complete"
 ${FLATPAK} ${U} clean --dry-run > clean-dry-run-out
 assert_file_has_content clean-dry-run-out "Would free:"
+assert_file_has_content clean-dry-run-out "prefetch-cleanup"
 ostree --repo="${FL_DIR}/repo" show --list-detached-metadata-keys "${EXTRA_DATA_COMMIT}" > detached-keys
 assert_file_has_content detached-keys "^xa.extra-data$"
 assert_has_file "${USERDIR}/extra-data/cleanup/orphan.part"
+assert_has_file "${USERDIR}/extra-data/prefetch-cleanup/complete"
 
 ${FLATPAK} ${U} clean > clean-out
 assert_file_has_content clean-out "Freed:"
@@ -91,6 +97,7 @@ assert_not_file_has_content detached-keys "^xa.extra-data$"
 assert_file_has_content detached-keys "^ostree.gpgsigs$"
 assert_not_has_file "${USERDIR}/extra-data/cleanup/orphan.part"
 assert_has_file "${USERDIR}/extra-data/cleanup/keep.txt"
+assert_not_has_dir "${USERDIR}/extra-data/prefetch-cleanup"
 ${FLATPAK} run --command=sh org.test.Hello -c "cat /app/extra/test" > out
 assert_file_has_content out "extra-data-test-content"
 ${FLATPAK} ${U} config --unset keep-extra-data
@@ -124,11 +131,36 @@ wait "${LOCK_PID}"
 rm "${LOCK_READY}"
 ok "reject clean while repository is locked"
 
+# A complete file left by an interrupted prefetch is reused and reclaimed.
+mkdir -p "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}"
+touch "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/.flatpak-prefetch"
+cp "${DOWNLOADED_EXTRA_DATA}" "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/${EXTRA_DATA_NAME}"
+printf partial > "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/${EXTRA_DATA_NAME}.part"
+: > "${EVENTS_LOG}"
+${FLATPAK} ${U} install -y ${REPONAME}-repo org.test.Hello ${BRANCH} >&2
+assert_not_file_has_content "${EVENTS_LOG}" "/${EXTRA_DATA_FILE}"
+assert_not_has_dir "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}"
+${FLATPAK} ${U} uninstall -y org.test.Hello >&2
+ok "reuse and reclaim interrupted extra data prefetch"
+
+# An invalid complete file left by an interrupted prefetch is downloaded again.
+mkdir -p "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}"
+touch "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/.flatpak-prefetch"
+printf invalid > "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/${EXTRA_DATA_NAME}"
+: > "${EVENTS_LOG}"
+${FLATPAK} ${U} install -y ${REPONAME}-repo org.test.Hello ${BRANCH} >&2
+assert_file_has_content "${EVENTS_LOG}" "/${EXTRA_DATA_FILE}"
+assert_not_has_dir "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}"
+${FLATPAK} ${U} uninstall -y org.test.Hello >&2
+ok "replace invalid interrupted extra data prefetch"
+
 # A file supplied by the user must never be removed by the prefetcher.
 mkdir -p "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}"
-cp "${DOWNLOADED_EXTRA_DATA}" "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/${EXTRA_DATA_FILE}"
+cp "${DOWNLOADED_EXTRA_DATA}" "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/${EXTRA_DATA_NAME}"
+: > "${EVENTS_LOG}"
 ${FLATPAK} ${U} install -y ${REPONAME}-repo org.test.Hello ${BRANCH} >&2
-assert_has_file "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/${EXTRA_DATA_FILE}"
+assert_not_file_has_content "${EVENTS_LOG}" "/${EXTRA_DATA_FILE}"
+assert_has_file "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/${EXTRA_DATA_NAME}"
 ${FLATPAK} ${U} uninstall -y org.test.Hello >&2
 rm -rf "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}"
 ok "preserve user-provided extra data"
