+  'flatpak-extra-data-private.c',
   'flatpak-extra-data-prefetch.c',
   'flatpak-exports.c',
   'flatpak-glib-backports.c',
diff --git a/system-helper/flatpak-system-helper.c b/system-helper/flatpak-system-helper.c
index 7547c781..98afd7a2 100644
--- a/system-helper/flatpak-system-helper.c
+++ b/system-helper/flatpak-system-helper.c
@@ -1116,7 +1116,8 @@ handle_configure (FlatpakSystemHelper   *object,
       (strcmp (arg_key, "extra-languages") != 0) &&
       (strcmp (arg_key, "masked") != 0) &&
       (strcmp (arg_key, "pinned") != 0) &&
-      (strcmp (arg_key, "extra-data-parallel") != 0))
+      (strcmp (arg_key, "extra-data-parallel") != 0) &&
+      (strcmp (arg_key, "keep-extra-data") != 0))
     {
       g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR, G_DBUS_ERROR_INVALID_ARGS,
                                              "Unsupported key: %s", arg_key);
diff --git a/tests/test-config.sh b/tests/test-config.sh
index 3181f3bb..170d5253 100755
--- a/tests/test-config.sh
+++ b/tests/test-config.sh
@@ -27,6 +27,7 @@ export LC_ALL=C
 ${FLATPAK} config --list > list_out
 assert_file_has_content list_out "^languages:"
 assert_file_has_content list_out "^extra-data-parallel: [*]unset[*] [(]default: 4[)]"
+assert_file_has_content list_out "^keep-extra-data: [*]unset[*] [(]default: false[)]"
 
 ok "config list"
 
diff --git a/tests/test-extra-data.sh b/tests/test-extra-data.sh
index 801ffabd..b126cb4a 100755
--- a/tests/test-extra-data.sh
+++ b/tests/test-extra-data.sh
@@ -60,10 +60,24 @@ ${FLATPAK} run --command=sh org.test.Hello -c "cat /app/extra/test" > out
 assert_file_has_content out "extra-data-test-content"
 assert_not_has_file "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/${EXTRA_DATA_NAME}"
 
+EXTRA_DATA_COMMIT=$(${FLATPAK} ${U} info --show-commit org.test.Hello)
+ostree --repo="${FL_DIR}/repo" show --list-detached-metadata-keys "${EXTRA_DATA_COMMIT}" > detached-keys
+assert_not_file_has_content detached-keys "^xa.extra-data$"
+assert_file_has_content detached-keys "^ostree.gpgsigs$"
+
 ${FLATPAK} ${U} uninstall -y org.test.Hello >&2
 
 ok "install extra data app with ostree"
 
+${FLATPAK} ${U} config --set keep-extra-data true
+${FLATPAK} ${U} install -y ${REPONAME}-repo org.test.Hello ${BRANCH} >&2
+ostree --repo="${FL_DIR}/repo" show --list-detached-metadata-keys "${EXTRA_DATA_COMMIT}" > detached-keys
+assert_file_has_content detached-keys "^xa.extra-data$"
+assert_file_has_content detached-keys "^ostree.gpgsigs$"
+${FLATPAK} ${U} uninstall -y org.test.Hello >&2
+${FLATPAK} ${U} config --unset keep-extra-data
+ok "keep extra data in detached metadata when configured"
+
 # A complete file left by an interrupted prefetch is reused and reclaimed.
 mkdir -p "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}"
 touch "${USERDIR}/extra-data/${EXTRA_DATA_SHA256}/.flatpak-prefetch"
